# Copy to .env (or export in your shell / Kaggle notebook). All are optional.

# Raw downloads, one folder per dataset (Market-1501-v15.09.15/, MSMT17_V1/, MARS/, MOT17/, ...).
REIDFM_RAW_ROOT=raw

# Converted pool: <root>/<dataset>/manifest.csv. Several roots may be joined with the
# OS path separator (":" on Linux/Kaggle), e.g. /kaggle/input/reid-pool-image:/kaggle/input/reid-pool-video
REIDFM_DATA_ROOT=pool

# Training runs (FastReID OUTPUT_DIR is created under this root).
REIDFM_OUTPUT_ROOT=outputs

# Downloaded zoo checkpoints and their converted init copies.
REIDFM_WEIGHTS_ROOT=weights

# Stop cleanly and checkpoint before this many hours (Kaggle sessions are 12 h).
REIDFM_TIME_BUDGET_H=11
